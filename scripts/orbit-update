#!/usr/bin/env bash
set -euo pipefail
umask 077
stage=
trap '[[ -z "$stage" ]] || rm -rf -- "$stage"' EXIT
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
main() {
    local role=server version='' repository=${ORBIT_RELEASE_REPOSITORY:-}
    local -a options=()
    while (( $# )); do
        case "$1" in
            --role|--version|--repo)
                [[ $# -ge 2 && -n "${2:-}" ]] || fail "$1 requires a value"
                case "$1" in --role) role=$2 ;; --version) version=$2 ;; --repo) repository=$2 ;; esac
                shift 2 ;;
            --skip-host) shift ;;
            -h|--help)
                printf '%s\n' 'Usage: orbit-update --role server|host [--version TAG] [--repo OWNER/REPO]' \
                    'Updates only the selected role through the Orbit release installer.'; return ;;
            *) fail "unknown argument: $1" ;;
        esac
    done
    [[ "$role" == server || "$role" == host ]] || fail 'invalid role'
    [[ -z "$version" || "$version" =~ ^v[0-9][A-Za-z0-9._-]*$ ]] || fail 'invalid version'
    local root=${HOME:?HOME must be set}/.local/lib config runtime
    if [[ "$role" == server ]]; then
        [[ ${ORBIT_INSTALL_ROOT:-$root/orbit} == "$root/orbit" ]] || fail 'unsupported ORBIT_INSTALL_ROOT'
        config=$root/orbit/update.json
        runtime=$root/orbit/latest/backend/node
    else
        config=$root/orbit-host/installation.json
        runtime=$root/orbit-host/current/runtime/node
    fi
    if [[ -f "$config" ]]; then
        [[ -x "$runtime" ]] || fail 'installed runtime is missing; reinstall the selected role'
        local saved
        saved=$("$runtime" --input-type=module - "$config" <<'JS'
import { readFileSync } from 'node:fs';
const value = JSON.parse(readFileSync(process.argv[2], 'utf8')).repository;
if (value != null && typeof value !== 'string') throw new Error('invalid saved repository');
process.stdout.write(value || '');
JS
)
        # Migrate the old development-repository update source once. Explicit
        # repository selections continue to support forks and test releases.
        if [[ -z "$repository" ]]; then
            case "$saved" in yorkart/orbit|yorkart/orbit-host) ;; *) repository=$saved ;; esac
        fi
        if [[ "$role" == server && -z ${ORBIT_USER_BIN_DIR:-} ]]; then
            ORBIT_USER_BIN_DIR=$("$runtime" --input-type=module - "$config" <<'JS'
import { readFileSync } from 'node:fs';
const value = JSON.parse(readFileSync(process.argv[2], 'utf8')).user_bin_dir;
if (value != null && (typeof value !== 'string' || !value.startsWith('/'))) throw new Error('invalid command directory');
process.stdout.write(value || '');
JS
)
            export ORBIT_USER_BIN_DIR
        fi
    fi
    repository=${repository:-yorkart/orbit-release}
    [[ "$repository" =~ ^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$ ]] || fail 'invalid repository'
    # A versioned update bootstraps from that same release, never latest.
    local url=https://github.com/$repository/releases/latest/download/orbit-install.sh
    if [[ -n "$version" ]]; then
        url=https://github.com/$repository/releases/download/$version/orbit-install.sh
        options+=(--version "$version")
    fi
    stage=$(mktemp -d)
    curl --fail --show-error --location --retry 3 --connect-timeout 15 \
        --proto '=https' --proto-redir '=https' --output "$stage/install.sh" "$url"
    [[ -s "$stage/install.sh" ]] || fail 'empty installer'
    bash -n "$stage/install.sh"
    bash "$stage/install.sh" --role "$role" --repo "$repository" ${options[@]+"${options[@]}"}
}
main "$@"
